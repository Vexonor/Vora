{
  "name": "learn-nest",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "bun x rimraf dist",
    "build": "bun x nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "bun x nest start",
    "start:dev": "bun --watch ./src/main.ts",
    "start:debug": "bun --watch --inspect ./src/main.ts",
    "start:prod": "bun ./src/main.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migrate:all": "bun scripts/migrate-all-dbs.ts",
    "pre-commit": "npm run format && npm run lint && npm run type-check && npm run test",
    "quality-check": "npm run format:check && npm run lint:check && npm run type-check && npm run test:cov",
    "setup-hooks": "husky install && chmod +x .husky/pre-commit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@nestjs/common": "^11.2.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/sequelize": "^11.0.1",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "joi": "^18.2.9",
    "midtrans-client": "^1.4.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.6",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.16.2",
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "^1.4.2",
    "@types/compression": "^1.8.1",
    "@types/config": "^3.3.5",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/sequelize": "^4.28.20",
    "@types/supertest": "^6.0.3",
    "@types/validator": "^13.15.10",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.9",
    "sequelize-cli": "^6.6.5",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "overrides": {
    "dottie": "^2.0.7",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "path-to-regexp": "^8.4.2",
    "qs": "^6.16.0",
    "validator": "^13.15.35"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
